# ICEA Platform MVP (v0.7.4)

# Production defaults are secure; enable DEBUG only for local dev.
DJANGO_DEBUG=false
SECRET_KEY=change-me
# Comma-separated. For production, set explicitly (no wildcard).
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

POSTGRES_HOST=db
POSTGRES_DB=icea_db
POSTGRES_USER=icea_user
POSTGRES_PASSWORD=icea_pass

ICEA_VERSION=0.7.4
ICEA_MODEL_DIR=/app/backend/models
ICEA_DATA_DIR=/app/backend/data
ICEA_SEED_DEMO=true
ICEA_DEMO_ROWS=800
# Optional startup fail-fast after migrations/demo seed. Keep false unless the
# target environment has the governed demo/model artifacts expected by readiness.
ICEA_RUN_READINESS_CHECK=false

# --- Enterprise feature flags (graceful degradation)
# Install optional deps at container start (keeps default image minimal)
ICEA_INSTALL_OPTIONAL_DEPS=false

# Run ASGI server (daphne/uvicorn) instead of gunicorn WSGI
ICEA_RUN_ASGI=false

# Enable Channels/WebSockets if installed
ICEA_ENABLE_CHANNELS=false

# --- Governance / Audit
AUDIT_LOG_SECRET=change-me-audit-secret

# Optional: identify Rothman Index observations to build episode-windows targets.
# Default (if empty): 85556-9 (LOINC: Rothman Index Calculated)
# You may add local codes too, comma-separated.
ROTHMAN_OBS_CODES=

# Optional: LOINC codes for component-level forensic missingness (26-variable proxy map).
# If empty, the platform uses a conservative open proxy list (vitals/labs/scores).
ROTHMAN_COMPONENT_LOINC_CODES=

# Optional: semantic mapping (do NOT commit licensed content)
# Provide either a JSON file path or an inline JSON string.
# NNN_MAPPING_PATH=/run/secrets/nnn_mapping.json
# NNN_MAPPING_JSON={"nanda_to_snomed":{},"nic_to_snomed":{},"noc_to_loinc":{}}

# --- FHIR
FHIR_BASE_URL=https://example-fhir-server/fhir
FHIR_BEARER_TOKEN=replace-with-token
FHIR_WRITEBACK_ENABLED=false

# v0.5.5+: return conformal prediction intervals (if model was trained with conformal metrics)
ICEA_CONFORMAL_ENABLED=false

# v0.6: standardized fairness metrics (optional; requires fairlearn in requirements-optional.txt)
FAIRNESS_USE_FAIRLEARN=false

# v0.6: row-level history via django-simple-history (optional)
ICEA_ENABLE_SIMPLE_HISTORY=false

# Strict FHIR validation (requires: pip install -r requirements-optional.txt)
FHIR_STRICT_VALIDATION=false
# Optional profile enforcement: comma-separated profile URLs expected in meta.profile
FHIR_REQUIRED_PROFILES=
# If true, missing strict validator will fail closed (500). Default: false (degrades gracefully)
FHIR_STRICT_FAIL_CLOSED=false

# --- Scheduler
ICEA_TRAIN_INTERVAL_S=86400

# Optional API key gate (if set, requires X-ICEA-API-KEY)
ICEA_API_KEY=

# --- Security hardening
ICEA_SECURE_MODE=false
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# --- CORS/CSRF
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Auth/JWT (SimpleJWT)
# Sensitive ICEA endpoints fail closed unless ICEA_DEV_ALLOW_INSECURE=true is set for local dev.
ICEA_DEV_ALLOW_INSECURE=false
ICEA_AUTH_REQUIRED=true
ICEA_RBAC_ENFORCE=true
ICEA_JWT_ROLE_CLAIM=roles
ICEA_RBAC_RULES_JSON=

JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=
JWT_VERIFYING_KEY=
JWT_AUDIENCE=
JWT_ISSUER=
OIDC_JWKS_URL=

# ICEA high-risk feature opt-ins. Keep false unless an approved research/admin workflow needs them.
ICEA_POLICY_LEARNING_ENABLED=false
ICEA_FAIRNESS_ENABLED=false
ICEA_CAUSAL_DISCOVER_ENABLED=false
ICEA_SIMULATE_ENABLED=false
ICEA_FEDERATED_ENABLED=false

# --- PHI encryption/retention
# Required when ICEA_SECURE_MODE=true. In local dev only,
# ICEA_DEV_ALLOW_INSECURE=true permits a SECRET_KEY-derived fallback.
PHI_ENCRYPTION_KEYS=
PHI_RETENTION_DAYS=30
PHI_RETENTION_ACTION=delete

# --- Federated Learning (v0.7)
# If set, client updates require a valid HMAC signature header X-ICEA-FED-SIG
ICEA_FEDERATED_SECRET=

# --- Zero-Trust perimeter (v0.7.2) — OFF by default
ICEA_ENABLE_REQUEST_LIMITS=false
ICEA_MAX_REQUEST_SIZE_MB=5

# v0.7.4: dynamic per-route limits (MB) as JSON mapping of path-prefix -> cap
# Example: '{"/api/v1/federated/": 10, "/api/v1/pipeline/ingest/": 5, "/api/v1/fhir/writeback/": 1}'
ICEA_ROUTE_SIZE_LIMITS_JSON=

# Global anonymous/user throttling plus scoped throttling are enabled together by default.
ICEA_ENABLE_THROTTLING=true
# Global anonymous/user throttles and scoped throttles are always enabled together.
ICEA_ANON_RATE_LIMIT=100/day
ICEA_USER_RATE_LIMIT=1000/hour

# Scoped throttling for governed ICEA surfaces
ICEA_THROTTLE_SCOPE_ICEA_READ=600/hour
ICEA_THROTTLE_SCOPE_ICEA_COMPUTE=180/hour
ICEA_THROTTLE_SCOPE_ICEA_TRAIN=20/hour
ICEA_THROTTLE_SCOPE_ICEA_EXPORT=60/hour
ICEA_THROTTLE_SCOPE_ICEA_WRITEBACK=30/hour
ICEA_THROTTLE_SCOPE_INGEST=500/hour
ICEA_THROTTLE_SCOPE_FEDERATED=20/day

# Mandatory HMAC signing for critical endpoints (ingest/writeback/federated)
ICEA_AUDIT_SIGNING_REQUIRED=false
ICEA_AUDIT_SECRET=change-me-to-a-strong-random-secret

# v0.7.4: anti-replay (timestamp + nonce) — OFF by default
ICEA_ANTI_REPLAY_REQUIRED=false
ICEA_REPLAY_WINDOW_SECONDS=300
