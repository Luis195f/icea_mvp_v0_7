# === Next.js Nursing Command Center (BFF) ===
# Base URL of the Django backend (NO /api/v1 suffix).
ICEA_BACKEND_BASE_URL=http://localhost:8000

# Optional API key gate (backend OptionalAPIKeyMiddleware).
# If ICEA_API_KEY is set in Django, set it here too.
# ICEA_API_KEY=

# Unified ENS/Zero-Trust signing secret (backend ICEA_AUDIT_SECRET).
# REQUIRED if ICEA_AUDIT_SIGNING_REQUIRED=true in Django.
# ICEA_AUDIT_SECRET=

# Optional: legacy federated signature secret (backend ICEA_FEDERATED_SECRET)
# REQUIRED ONLY if ICEA_ENABLE_LEGACY_FED_SIGNATURE=true AND ICEA_FEDERATED_SECRET is set in Django (non-ENS mode).
# ICEA_FEDERATED_SECRET=

# Optional: set a default tenant theme (white-label). If empty, "default".
ICEA_TENANT=default

# Cookie security: set true behind HTTPS/reverse-proxy in prod.
# ICEA_COOKIE_SECURE=true
