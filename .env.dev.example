# ICEA+ DEV defaults (DO NOT use with PHI)
DJANGO_DEBUG=true
SECRET_KEY=unsafe-secret-for-dev
ALLOWED_HOSTS=*

POSTGRES_HOST=db
POSTGRES_DB=icea_db
POSTGRES_USER=icea_user
POSTGRES_PASSWORD=icea_pass

REDIS_URL=redis://redis:6379/0

ICEA_VERSION=0.7.4
ICEA_SEED_DEMO=true

# Perimeter (off by default in dev)
ICEA_ENABLE_REQUEST_LIMITS=false
ICEA_ENABLE_THROTTLING=false
ICEA_AUDIT_SIGNING_REQUIRED=false
ICEA_ANTI_REPLAY_REQUIRED=false

# FHIR
FHIR_STRICT_VALIDATION=false
FHIR_REQUIRED_PROFILES=
