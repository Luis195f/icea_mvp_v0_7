# Local free demo rehearsal template.
# Copy values into your shell or a local untracked .env file only after
# generating fresh ephemeral values. Do not commit generated secrets.

DJANGO_DEBUG=false
SECRET_KEY=<generate-locally-with-secrets-token_urlsafe>
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

ICEA_SECURE_MODE=true
ICEA_DEV_ALLOW_INSECURE=false
ICEA_AUTH_REQUIRED=true
ICEA_RBAC_ENFORCE=true

JWT_SIGNING_KEY=<generate-locally-with-secrets-token_urlsafe>
AUDIT_LOG_SECRET=<generate-locally-with-secrets-token_urlsafe>
PHI_ENCRYPTION_KEYS=<generate-locally-with-Fernet.generate_key>

ICEA_ENABLE_THROTTLING=true
CORS_ALLOW_ALL_ORIGINS=false
